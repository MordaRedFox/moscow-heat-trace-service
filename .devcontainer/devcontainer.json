{
  "name": "heat-trace-service (Java 11 / Spring Boot 2.6.3)",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  // Рабочая папка и ее монтирование
  "workspaceFolder": "/workspaces/moscow-heat-trace-service",
  "shutdownAction": "stopCompose",
  // Порты: 8080 - приложение, 5005 - удаленная отладка, 5432 - PostgreSQL,
  // 9200 - OpenSearch
  "forwardPorts": [8080, 5005, 5432, 9200, 9600],
  "remoteUser": "vscode",
  "remoteEnv": {
    "SDKMAN_DIR": "/usr/local/sdkman",
    "PATH": "/usr/local/sdkman/candidates/maven/current/bin:/usr/local/sdkman/candidates/java/current/bin:${containerEnv:PATH}"
  },
  // Скрипты вынесены в отдельные файлы
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "bash .devcontainer/post-start.sh",
  // Расширения и настройки VS Code внутри контейнера
  "customizations": {
    "vscode": {
      "extensions": [
        // Java и Spring Boot
        "vscjava.vscode-java-pack",
        "vmware.vscode-boot-dev-pack",
        // Docker
        "ms-azuretools.vscode-docker",
        // YAML, JSON, GeoJSON
        "redhat.vscode-yaml",
        "randomfractalsinc.geo-data-viewer",
        // Git
        "eamodio.gitlens",
        "mhutchie.git-graph",
        // Утилиты
        "editorconfig.editorconfig"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.tabSize": 4,
        "files.eol": "\n",
        "files.insertFinalNewline": true,
        "files.trimTrailingWhitespace": true,
        "terminal.integrated.defaultProfile.linux": "bash",
        "json.schemaDownload.enable": true,
        "json.schemaDownload.trustedDomains": {
          "https://raw.githubusercontent.com": true
        },
        // Maven и Java
        "java.configuration.maven.userSettings": "/home/vscode/.m2/settings.xml",
        "maven.executable.path": "/usr/local/sdkman/candidates/maven/current/bin/mvn"
      }
    }
  }
}
